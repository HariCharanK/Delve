{
  "name": "delve",
  "displayName": "Delve",
  "description": "Local hybrid search for your notes",
  "version": "0.2.1",
  "publisher": "delve",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "delve.search",
        "title": "Delve: Search Notes"
      },
      {
        "command": "delve.reindex",
        "title": "Delve: Reindex Notes"
      },
      {
        "command": "delve.focusSearch",
        "title": "Delve: Focus Search Input"
      }
    ],
    "keybindings": [
      {
        "command": "delve.focusSearch",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      }
    ],
    "viewsWelcome": [
      {
        "view": "delve.results",
        "contents": "Type a query in the search box above to find notes."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "delve",
          "title": "Delve",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "delve": [
        {
          "id": "delve.searchInput",
          "name": "Search",
          "type": "webview"
        },
        {
          "id": "delve.results",
          "name": "Results"
        }
      ]
    },
    "configuration": {
      "title": "Delve",
      "properties": {
        "delve.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9120",
          "description": "URL of the Delve backend server"
        },
        "delve.notesDir": {
          "type": "string",
          "default": "~/notes",
          "description": "Directory containing your notes files"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.0"
  }
}
